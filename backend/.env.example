# Runtime environment
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgres://ikuck:ikuck@127.0.0.1:5432/ikuck
REDIS_URL=redis://127.0.0.1:6379
APP_ORIGIN=http://localhost:5173
LOG_LEVEL=debug
# Client timestamps farther than this tolerance in the future are clamped to server time.
SYNC_MAX_CLIENT_CLOCK_SKEW_SECONDS=300
# Optional: comma-separated proxy IPs or CIDRs that are allowed to provide the client IP.
# TRUST_PROXY=127.0.0.1

# Provider credentials are optional until their feature is enabled.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM=
USDA_API_KEY=
OPENAI_API_KEY=
GOOGLE_CLIENT_ID=
