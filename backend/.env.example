# Runtime environment
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgres://ikuck:ikuck@127.0.0.1:5432/ikuck
REDIS_URL=redis://127.0.0.1:6379
APP_ORIGIN=http://localhost:5173
LOG_LEVEL=debug
# Client timestamps farther than this tolerance in the future are clamped to server time.
SYNC_MAX_CLIENT_CLOCK_SKEW_SECONDS=300
# Optional: comma-separated proxy IPs or CIDRs that are allowed to provide the client IP.
# TRUST_PROXY=127.0.0.1

# Provider credentials are optional until their feature is enabled.
# Email delivery (ADR-001) talks to the SMTP server directly: TLS is always required
# (implicit TLS on port 465, STARTTLS on every other port).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
SMTP_TIMEOUT_MS=10000
USDA_API_KEY=
USDA_TIMEOUT_MS=8000
OPENAI_API_KEY=
OPENAI_TIMEOUT_MS=30000
GOOGLE_CLIENT_ID=

# Bring! integration is opt-in; keep its encryption key only in the API environment.
BRING_ENABLED=false
# Generate 32 random bytes and encode them as 64 hexadecimal characters.
BRING_TOKEN_ENCRYPTION_KEY=
# Required when BRING_ENABLED=true: the dedicated test list id; all other Bring! lists remain unavailable.
BRING_TEST_LIST_ID=
