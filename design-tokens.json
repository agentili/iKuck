{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Un sistema locale-first per decidere cosa cucinare con ciò che è già in casa.",
  "color": {
    "$type": "color",
    "primary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.659,
          0.435,
          0.290
        ],
        "hex": "#A86F4A"
      }
    },
    "porcelain": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1.0,
          0.973,
          0.941
        ],
        "hex": "#FFF8F0"
      }
    },
    "apricot": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.910,
          0.659,
          0.486
        ],
        "hex": "#E8A87C"
      }
    },
    "apricotDark": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.784,
          0.545,
          0.369
        ],
        "hex": "#C88B5E"
      }
    },
    "peach": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1.0,
          0.910,
          0.839
        ],
        "hex": "#FFE8D6"
      }
    },
    "cream": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1.0,
          0.941,
          0.878
        ],
        "hex": "#FFF0E0"
      }
    },
    "tomato": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.961,
          0.663,
          0.663
        ],
        "hex": "#F5A9A9"
      }
    },
    "yolk": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1.0,
          0.839,
          0.647
        ],
        "hex": "#FFD6A5"
      }
    },
    "inkMuted": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.545,
          0.451,
          0.333
        ],
        "hex": "#8B7355"
      }
    }
  },
  "spacing": {
    "$type": "dimension",
    "xs": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "sm": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "xl": {
      "$value": {
        "value": 32,
        "unit": "px"
      }
    }
  },
  "rounded": {
    "$type": "dimension",
    "control": {
      "$value": {
        "value": 12,
        "unit": "px"
      }
    },
    "panel": {
      "$value": {
        "value": 20,
        "unit": "px"
      }
    },
    "feature": {
      "$value": {
        "value": 28,
        "unit": "px"
      }
    }
  },
  "typography": {
    "h1": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Bricolage Grotesque Variable, system-ui, sans-serif",
        "fontSize": {
          "value": 3.75,
          "unit": "rem"
        },
        "fontWeight": 800,
        "letterSpacing": {
          "value": -0.03,
          "unit": "em"
        }
      }
    },
    "h2": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Bricolage Grotesque Variable, system-ui, sans-serif",
        "fontSize": {
          "value": 2,
          "unit": "rem"
        },
        "fontWeight": 800,
        "letterSpacing": {
          "value": -0.02,
          "unit": "em"
        }
      }
    },
    "body-md": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Bricolage Grotesque Variable, system-ui, sans-serif",
        "fontSize": {
          "value": 1,
          "unit": "rem"
        },
        "fontWeight": 450
      }
    }
  }
}