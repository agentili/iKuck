    "display": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Georgia, Times New Roman, serif",
        "fontSize": {
          "value": 2.75,
          "unit": "rem"
        },
        "fontWeight": 400,
        "letterSpacing": {
          "value": -0.04,
          "unit": "em"
        }
      }
    },
    "body-md": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Bricolage Grotesque Variable, system-ui, sans-serif",
        "fontSize": {
          "value": 1,
          "unit": "rem"
        },
        "fontWeight": 450
      }
    }
  },
  "components": {
    "button-primary": {
      "backgroundColor": "{color.basil}",
      "textColor": "{color.porcelain}",
      "rounded": "{rounded.control}",
      "minimumHeight": {
        "$value": {
          "value": 44,
          "unit": "px"
        }
      }
    },
    "button-primary-hover": {
      "backgroundColor": "{color.basilDark}",
      "textColor": "{color.porcelain}",
      "rounded": "{rounded.control}"
    },
    "editorial-panel": {
      "backgroundColor": "{color.surface}",
      "textColor": "{color.ink}",
      "borderColor": "{color.border}",
      "rounded": "{rounded.panel}"
    },
    "action-panel": {
      "backgroundColor": "{color.ink}",
      "textColor": "{color.porcelain}",
      "rounded": "{rounded.feature}"
    },
    "ready-recipe": {
      "backgroundColor": "{color.sage}",
      "textColor": "{color.primary}",
      "rounded": "{rounded.panel}"
    },
    "one-purchase-recipe": {
      "backgroundColor": "{color.yolk}",
      "textColor": "{color.onYolk}",
      "rounded": "{rounded.panel}"
    },
    "error-surface": {
      "backgroundColor": "{color.tomatoSoft}",
      "textColor": "{color.tomato}",
      "rounded": "{rounded.panel}"
    }
  }
